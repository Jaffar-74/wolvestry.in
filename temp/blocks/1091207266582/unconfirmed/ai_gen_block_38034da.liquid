{% doc %}
  @prompt
    similarly can you help with the footer ? with allthe required placeholders for the page ? with y actial logo 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 44px 5%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-footer-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(180px, 1.3fr) repeat(3, minmax(120px, 1fr));
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-footer-{{ ai_gen_id }}__brand { min-width: 0; }
  .ai-footer-{{ ai_gen_id }}__logo { display: block; width: {{ block.settings.logo_width }}px; max-width: 100%; height: auto; }
  .ai-footer-{{ ai_gen_id }}__logo-placeholder { width: {{ block.settings.logo_width }}px; max-width: 100%; color: {{ block.settings.text_color }}; }
  .ai-footer-{{ ai_gen_id }}__logo-placeholder svg { display: block; width: 100%; height: auto; }
  .ai-footer-{{ ai_gen_id }}__empty-hint { margin: 8px 0 0; font-size: 12px; opacity: .8; }
  .ai-footer-{{ ai_gen_id }}__description { margin: 16px 0 0; line-height: 1.6; }
  .ai-footer-{{ ai_gen_id }}__column h2 { margin: 0 0 14px; color: {{ block.settings.heading_color }}; font-size: 16px; }
  .ai-footer-{{ ai_gen_id }}__links { display: grid; gap: 10px; }
  .ai-footer-{{ ai_gen_id }}__links a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .ai-footer-{{ ai_gen_id }}__links a:hover { opacity: .75; }
  .ai-footer-{{ ai_gen_id }}__links a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .ai-footer-{{ ai_gen_id }}__bottom { max-width: 1200px; margin: 32px auto 0; padding-top: 18px; border-top: 1px solid currentColor; }
  .ai-footer-{{ ai_gen_id }}__bottom p { margin: 0; font-size: 13px; }

  @media screen and (max-width: 749px) {
    .ai-footer-{{ ai_gen_id }} { padding: 32px 6%; }
    .ai-footer-{{ ai_gen_id }}__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; }
    .ai-footer-{{ ai_gen_id }}__brand { grid-column: 1 / -1; }
  }
{% endstyle %}

<footer class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-{{ ai_gen_id }}__inner">
    <div class="ai-footer-{{ ai_gen_id }}__brand">
      {% if block.settings.logo != blank %}
        <img class="ai-footer-{{ ai_gen_id }}__logo" src="{{ block.settings.logo | image_url: width: 600 }}" alt="{{ block.settings.logo.alt | default: shop.name | escape }}" loading="lazy" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}">
      {% else %}
        <div class="ai-footer-{{ ai_gen_id }}__logo-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
        <p class="ai-footer-{{ ai_gen_id }}__empty-hint">Add your store logo in this block's settings.</p>
      {% endif %}
      {% if block.settings.description != blank %}<p class="ai-footer-{{ ai_gen_id }}__description">{{ block.settings.description | escape }}</p>{% endif %}
    </div>

    {% for i in (1..3) %}
      {% liquid
        assign title_key = 'column_' | append: i | append: '_title'
        assign heading = block.settings[title_key]
      %}
      <nav class="ai-footer-{{ ai_gen_id }}__column" aria-label="{{ heading | default: 'Footer links' | escape }}">
        {% if heading != blank %}<h2>{{ heading | escape }}</h2>{% endif %}
        <div class="ai-footer-{{ ai_gen_id }}__links">
          {% for j in (1..4) %}
            {% liquid
              assign label_key = 'column_' | append: i | append: '_link_' | append: j
              assign url_key = 'column_' | append: i | append: '_url_' | append: j
              assign link_label = block.settings[label_key]
              assign link_url = block.settings[url_key]
            %}
            {% if link_label != blank and link_url != blank %}<a href="{{ link_url }}">{{ link_label | escape }}</a>{% endif %}
          {% endfor %}
        </div>
      </nav>
    {% endfor %}
  </div>
  <div class="ai-footer-{{ ai_gen_id }}__bottom"><p>{{ block.settings.copyright_text | escape }} {{ shop.name | escape }} · {{ 'now' | date: '%Y' }}</p></div>
</footer>

{% schema %}
{
  "name": "Store footer",
  "settings": [
    {"type":"header","content":"Brand"},
    {"type":"image_picker","id":"logo","label":"Store logo"},
    {"type":"range","id":"logo_width","label":"Logo width","min":60,"max":240,"step":10,"unit":"px","default":140},
    {"type":"text","id":"description","label":"Short description","default":"A short introduction to your store."},
    {"type":"header","content":"Link columns"},
    {"type":"text","id":"column_1_title","label":"Column 1 heading","default":"Explore"},
    {"type":"text","id":"column_1_link_1","label":"Column 1 link 1","default":"Shop all"},
    {"type":"url","id":"column_1_url_1","label":"Column 1 link 1 URL"},
    {"type":"text","id":"column_1_link_2","label":"Column 1 link 2","default":"About us"},
    {"type":"url","id":"column_1_url_2","label":"Column 1 link 2 URL"},
    {"type":"text","id":"column_1_link_3","label":"Column 1 link 3","default":"Contact"},
    {"type":"url","id":"column_1_url_3","label":"Column 1 link 3 URL"},
    {"type":"text","id":"column_1_link_4","label":"Column 1 link 4","default":"FAQ"},
    {"type":"url","id":"column_1_url_4","label":"Column 1 link 4 URL"},
    {"type":"text","id":"column_2_title","label":"Column 2 heading","default":"Customer care"},
    {"type":"text","id":"column_2_link_1","label":"Column 2 link 1","default":"Shipping information"},
    {"type":"url","id":"column_2_url_1","label":"Column 2 link 1 URL"},
    {"type":"text","id":"column_2_link_2","label":"Column 2 link 2","default":"Returns and exchanges"},
    {"type":"url","id":"column_2_url_2","label":"Column 2 link 2 URL"},
    {"type":"text","id":"column_2_link_3","label":"Column 2 link 3","default":"Size guide"},
    {"type":"url","id":"column_2_url_3","label":"Column 2 link 3 URL"},
    {"type":"text","id":"column_2_link_4","label":"Column 2 link 4","default":"Track your order"},
    {"type":"url","id":"column_2_url_4","label":"Column 2 link 4 URL"},
    {"type":"text","id":"column_3_title","label":"Column 3 heading","default":"Policies"},
    {"type":"text","id":"column_3_link_1","label":"Column 3 link 1","default":"Privacy policy"},
    {"type":"url","id":"column_3_url_1","label":"Column 3 link 1 URL"},
    {"type":"text","id":"column_3_link_2","label":"Column 3 link 2","default":"Terms of service"},
    {"type":"url","id":"column_3_url_2","label":"Column 3 link 2 URL"},
    {"type":"text","id":"column_3_link_3","label":"Column 3 link 3","default":"Refund policy"},
    {"type":"url","id":"column_3_url_3","label":"Column 3 link 3 URL"},
    {"type":"text","id":"column_3_link_4","label":"Column 3 link 4","default":"Contact information"},
    {"type":"url","id":"column_3_url_4","label":"Column 3 link 4 URL"},
    {"type":"text","id":"copyright_text","label":"Copyright prefix","default":"©"},
    {"type":"header","content":"Colors and layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"color","id":"background_color","label":"Background","default":"#171717"},
    {"type":"color","id":"text_color","label":"Text","default":"#F5F5F5"},
    {"type":"color","id":"heading_color","label":"Headings","default":"#FFFFFF"}
  ],
  "presets": [{"name":"Store footer"}],
  "tag": null,
  "class": "store-footer-block"
}
{% endschema %}