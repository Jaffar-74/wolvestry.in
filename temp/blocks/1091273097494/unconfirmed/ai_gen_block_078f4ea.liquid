{% doc %}
  @prompt
    I want asection for collections, best seller products, like I should i option fromwhere it goes to respective collections page.  with it shouding the amount, add to cart option and so on  
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-shelf-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 32px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-collection-shelf-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__heading-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.2;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__view-all {
    color: {{ block.settings.text_color }};
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__card {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__image-link {
    display: block;
    overflow: hidden;
    background: {{ block.settings.card_color }};
    aspect-ratio: 1 / 1;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__image-link img,
  .ai-collection-shelf-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding-top: 12px;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.35;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__price {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__compare {
    opacity: 0.7;
    text-decoration: line-through;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 44px;
    margin-top: auto;
    padding: 10px 14px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__button:hover {
    opacity: 0.88;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__button:focus-visible,
  .ai-collection-shelf-{{ ai_gen_id }}__view-all:focus-visible,
  .ai-collection-shelf-{{ ai_gen_id }}__title a:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  .ai-collection-shelf-{{ ai_gen_id }}__empty {
    padding: 24px;
    background: {{ block.settings.card_color }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-shelf-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-collection-shelf-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 16px 12px;
    }

    .ai-collection-shelf-{{ ai_gen_id }}__heading-row {
      align-items: flex-start;
    }

    .ai-collection-shelf-{{ ai_gen_id }}__title {
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-collection-shelf-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-shelf-{{ ai_gen_id }}__inner">
    <div class="ai-collection-shelf-{{ ai_gen_id }}__heading-row">
      <h2 class="ai-collection-shelf-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% if block.settings.collection != blank %}
        <a class="ai-collection-shelf-{{ ai_gen_id }}__view-all" href="{{ block.settings.collection.url }}">{{ block.settings.link_label | escape }}</a>
      {% endif %}
    </div>

    {% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}
      <div class="ai-collection-shelf-{{ ai_gen_id }}__grid">
        {% for product in block.settings.collection.products limit: block.settings.product_count %}
          <article class="ai-collection-shelf-{{ ai_gen_id }}__card">
            <a class="ai-collection-shelf-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
              {% else %}
                <div class="ai-collection-shelf-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </a>
            <div class="ai-collection-shelf-{{ ai_gen_id }}__info">
              <h3 class="ai-collection-shelf-{{ ai_gen_id }}__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              <div class="ai-collection-shelf-{{ ai_gen_id }}__price">
                <span>{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="ai-collection-shelf-{{ ai_gen_id }}__compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
              {% if product.available %}
                {% if product.has_only_default_variant %}
                  <form action="{{ routes.cart_add_url }}" method="post">
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button class="ai-collection-shelf-{{ ai_gen_id }}__button" type="submit">{{ block.settings.add_label | escape }}</button>
                  </form>
                {% else %}
                  <a class="ai-collection-shelf-{{ ai_gen_id }}__button" href="{{ product.url }}">{{ block.settings.choose_label | escape }}</a>
                {% endif %}
              {% else %}
                <button class="ai-collection-shelf-{{ ai_gen_id }}__button" type="button" disabled aria-disabled="true">{{ block.settings.sold_out_label | escape }}</button>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-collection-shelf-{{ ai_gen_id }}__empty">
        {% if block.settings.collection == blank %}Choose a collection in the block settings to show its products.{% else %}This collection does not have any products yet.{% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collection products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "link_label", "label": "Collection link label", "default": "View all" },
    { "type": "range", "id": "product_count", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "choose_label", "label": "Options label", "default": "Choose options" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "header", "content": "Colors and style" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#111111" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#1C1C1C" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F2EB" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#F5F2EB" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#111111" },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Collection products" }],
  "tag": null,
  "class": "collection-products-block"
}
{% endschema %}