<style>
  .wv-blog-{{ section.id }} {
    padding: var(--section-spacing, 4rem) 0;
  }

  .wv-blog-{{ section.id }} .wv-blog__heading {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(2rem, 5vw, 3.6rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
    line-height: 1.1;
    margin: 0 0 3rem;
    color: var(--wv-bone, #F5F0EB);
  }

  .wv-blog-{{ section.id }} .wv-blog__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .wv-blog-{{ section.id }} .wv-blog__card {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: opacity 0.2s ease;
  }

  .wv-blog-{{ section.id }} .wv-blog__card:hover {
    opacity: 0.85;
  }

  .wv-blog-{{ section.id }} .wv-blog__card-image {
    position: relative;
    overflow: hidden;
    padding-bottom: 60%;
    background: rgba(255, 255, 255, 0.03);
    margin-bottom: 1.25rem;
  }

  .wv-blog-{{ section.id }} .wv-blog__card-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .wv-blog-{{ section.id }} .wv-blog__card:hover .wv-blog__card-image img {
    transform: scale(1.04);
  }

  .wv-blog-{{ section.id }} .wv-blog__card-date {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--wv-muted, #999);
    font-family: var(--font-body, 'Inter', sans-serif);
    margin: 0 0 0.5rem;
  }

  .wv-blog-{{ section.id }} .wv-blog__card-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.3;
    color: var(--wv-bone, #F5F0EB);
    margin: 0 0 0.75rem;
  }

  .wv-blog-{{ section.id }} .wv-blog__card-excerpt {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--wv-muted, #999);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .wv-blog-{{ section.id }} .wv-blog__pagination {
    margin-top: 4rem;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .wv-blog-{{ section.id }} .wv-blog__pagination a,
  .wv-blog-{{ section.id }} .wv-blog__pagination span.current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--wv-muted, #999);
    text-decoration: none;
    font-size: 0.75rem;
    font-family: var(--font-body, 'Inter', sans-serif);
    transition: all 0.2s ease;
  }

  .wv-blog-{{ section.id }} .wv-blog__pagination a:hover,
  .wv-blog-{{ section.id }} .wv-blog__pagination span.current {
    background: var(--wv-bone, #F5F0EB);
    color: var(--wv-black, #0E0E0E);
    border-color: var(--wv-bone, #F5F0EB);
  }

  .wv-blog-{{ section.id }} .wv-blog__empty {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--wv-muted, #999);
    font-size: 0.9rem;
  }

  @media screen and (max-width: 749px) {
    .wv-blog-{{ section.id }} .wv-blog__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

<div class="wv-blog-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h1 class="wv-blog__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if blog.articles.size > 0 -%}
      {%- paginate blog.articles by section.settings.articles_per_page -%}
        <div class="wv-blog__grid">
          {%- for article in blog.articles -%}
            <a href="{{ article.url }}" class="wv-blog__card">
              {%- if article.image -%}
                <div class="wv-blog__card-image">
                  <img
                    src="{{ article.image | image_url: width: 800 }}"
                    srcset="
                      {{ article.image | image_url: width: 400 }} 400w,
                      {{ article.image | image_url: width: 800 }} 800w
                    "
                    sizes="(max-width: 749px) 100vw, 50vw"
                    alt="{{ article.image.alt | escape | default: article.title | escape }}"
                    loading="lazy"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                  >
                </div>
              {%- endif -%}

              <p class="wv-blog__card-date">{{ article.published_at | date: '%B %d, %Y' }}</p>
              <h2 class="wv-blog__card-title">{{ article.title }}</h2>

              {%- if article.excerpt_or_content != blank -%}
                <p class="wv-blog__card-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="wv-blog__pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                {%- if part.title == paginate.current_page -%}
                  <span class="current">{{ part.title }}</span>
                {%- else -%}
                  <span>{{ part.title }}</span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="wv-blog__empty">
        <p>No articles yet. Check back soon.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wolvestry Blog",
  "tag": "section",
  "class": "wv-blog-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE JOURNAL"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Wolvestry Blog"
    }
  ]
}
{% endschema %}
