<section
  class="wolvestry-newsletter"
  style="
    padding: var(--section-spacing) 0;
    {% if section.settings.color_scheme == 'dark' %}
      background: var(--wv-black); color: var(--wv-bone);
    {% elsif section.settings.color_scheme == 'light' %}
      background: var(--wv-bone); color: var(--wv-black);
    {% endif %}
  "
>
  <div class="page-width">
    <div class="wolvestry-newsletter__inner" style="
      text-align: center;
      max-width: 600px;
      margin: 0 auto;
    ">
      {% if section.settings.heading != blank %}
        <h2 style="
          font-family: var(--font-heading);
          font-size: clamp(2.4rem, 5vw, 4.8rem);
          letter-spacing: 0.1em;
          text-transform: uppercase;
          font-style: italic;
          margin: 0 0 1rem;
        ">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p style="
          color: var(--wv-muted);
          margin-bottom: 3rem;
          font-size: 0.95rem;
          line-height: 1.6;
          font-style: italic;
        ">
          {{ section.settings.text }}
        </p>
      {% endif %}

      {% form 'customer' %}
        {% if form.posted_successfully? %}
          <p class="wolvestry-newsletter__success" style="
            color: var(--wv-bone);
            margin-top: 1rem;
            font-size: 0.9rem;
            letter-spacing: 0.05em;
          ">
            Welcome to the pack. Check your inbox for your code.
          </p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {% if form.errors %}
            <div class="wolvestry-newsletter__errors" style="
              color: #e55;
              margin-bottom: 1.5rem;
              font-size: 0.85rem;
            ">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="wolvestry-newsletter__form" style="
            display: flex;
            max-width: 460px;
            margin: 0 auto;
          ">
            <input
              type="email"
              name="contact[email]"
              placeholder="Email address"
              required
              autocomplete="email"
              aria-label="Email address"
              style="
                flex: 1;
                background: transparent;
                border: 1px solid var(--wv-gunmetal);
                color: var(--wv-bone);
                padding: 1em 1.5em;
                font-family: var(--font-body);
                font-size: 0.85rem;
                letter-spacing: 0.05em;
                border-radius: 0;
                outline: none;
              "
            >
            <button
              type="submit"
              class="wv-btn"
              style="
                background: var(--wv-bone);
                color: var(--wv-black);
                border: 1px solid var(--wv-bone);
                border-left: none;
                padding: 1em 2em;
                font-family: var(--font-body);
                font-size: 0.75rem;
                letter-spacing: 0.2em;
                text-transform: uppercase;
                font-weight: 600;
                cursor: pointer;
                white-space: nowrap;
                border-radius: 0;
                transition: background 0.3s ease, color 0.3s ease;
              "
            >
              {{ section.settings.button_label }}
            </button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <style>
    .wolvestry-newsletter .wv-btn:hover {
      background: transparent;
      color: var(--wv-bone);
    }

    .wolvestry-newsletter input[type="email"]::placeholder {
      color: var(--wv-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 0.75rem;
    }

    .wolvestry-newsletter input[type="email"]:focus {
      border-color: var(--wv-bone);
    }
  </style>
</section>

{% schema %}
{
  "name": "Wolvestry Newsletter",
  "tag": "section",
  "class": "section-wolvestry-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE PACK."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Get 10% off your first order. No noise, just drops."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "CLAIM 10% OFF"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "light", "label": "Light" }
      ],
      "default": "dark"
    }
  ],
  "presets": [
    {
      "name": "Wolvestry Newsletter"
    }
  ]
}
{% endschema %}
