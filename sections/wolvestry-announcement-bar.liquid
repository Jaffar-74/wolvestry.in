{%- liquid
  assign text = section.settings.text
  assign link = section.settings.link
-%}

<style>
  .wv-announcement-{{ section.id }} {
    background: var(--wv-gunmetal, #2a3439);
    color: var(--wv-bone, #F5F0EB);
    padding: 0.7rem 1rem;
    text-align: center;
  }

  .wv-announcement-{{ section.id }} .wv-announcement__text {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.4;
  }

  .wv-announcement-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .wv-announcement-{{ section.id }} a:hover {
    opacity: 0.7;
  }
</style>

<div class="wv-announcement-{{ section.id }} color-{{ section.settings.color_scheme }}">
  {%- if link != blank -%}
    <a href="{{ link }}">
      <p class="wv-announcement__text">{{ text }}</p>
    </a>
  {%- else -%}
    <p class="wv-announcement__text">{{ text }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Wolvestry Announcement Bar",
  "tag": "section",
  "class": "wv-announcement-section",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Announcement text",
      "default": "FREE SHIPPING ON ORDERS ABOVE ₹999"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }
      ],
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "Wolvestry Announcement Bar"
    }
  ]
}
{% endschema %}
