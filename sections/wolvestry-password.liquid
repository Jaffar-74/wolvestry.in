<style>
  .wv-password-{{ section.id }} {
    background: var(--wv-black, #0E0E0E);
    color: var(--wv-bone, #F5F0EB);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .wv-password-{{ section.id }} .wv-password__inner {
    max-width: 520px;
    width: 100%;
    text-align: center;
  }

  .wv-password-{{ section.id }} .wv-password__logo {
    margin-bottom: 3rem;
  }

  .wv-password-{{ section.id }} .wv-password__logo-image {
    display: inline-block;
    max-width: 160px;
    height: auto;
  }

  .wv-password-{{ section.id }} .wv-password__logo-text {
    font-family: var(--wv-font-heading, 'Inter', sans-serif);
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--wv-bone, #F5F0EB);
  }

  .wv-password-{{ section.id }} .wv-password__heading {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(3rem, 8vw, 6rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 0.95;
    margin: 0 0 1.5rem;
    color: var(--wv-bone, #F5F0EB);
  }

  .wv-password-{{ section.id }} .wv-password__text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--wv-muted, #999);
    margin: 0 0 3rem;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .wv-password-{{ section.id }} .wv-password__form {
    display: flex;
    max-width: 420px;
    margin: 0 auto 2rem;
  }

  .wv-password-{{ section.id }} .wv-password__email-input {
    flex: 1;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-right: none;
    color: var(--wv-bone, #F5F0EB);
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.85rem;
    padding: 0.9rem 1.25rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .wv-password-{{ section.id }} .wv-password__email-input::placeholder {
    color: var(--wv-muted, #999);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
  }

  .wv-password-{{ section.id }} .wv-password__email-input:focus {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .wv-password-{{ section.id }} .wv-password__submit {
    background: var(--wv-bone, #F5F0EB);
    color: var(--wv-black, #0E0E0E);
    border: 1px solid var(--wv-bone, #F5F0EB);
    padding: 0.9rem 1.5rem;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .wv-password-{{ section.id }} .wv-password__submit:hover {
    opacity: 0.85;
  }

  .wv-password-{{ section.id }} .wv-password__success {
    font-size: 0.85rem;
    color: var(--wv-bone, #F5F0EB);
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
  }

  .wv-password-{{ section.id }} .wv-password__errors {
    color: #e55;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  /* Admin password entry */
  .wv-password-{{ section.id }} .wv-password__admin {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .wv-password-{{ section.id }} .wv-password__admin-toggle {
    background: none;
    border: none;
    color: var(--wv-muted, #999);
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .wv-password-{{ section.id }} .wv-password__admin-toggle:hover {
    color: var(--wv-bone, #F5F0EB);
  }

  .wv-password-{{ section.id }} .wv-password__admin-form {
    display: none;
    margin-top: 1.5rem;
    max-width: 320px;
    margin-left: auto;
    margin-right: auto;
  }

  .wv-password-{{ section.id }} .wv-password__admin-form.is-visible {
    display: block;
  }

  .wv-password-{{ section.id }} .wv-password__admin-input {
    width: 100%;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--wv-bone, #F5F0EB);
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.85rem;
    padding: 0.75rem 1rem;
    outline: none;
    margin-bottom: 0.75rem;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .wv-password-{{ section.id }} .wv-password__admin-input:focus {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .wv-password-{{ section.id }} .wv-password__admin-btn {
    width: 100%;
    padding: 0.75rem 1.5rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--wv-bone, #F5F0EB);
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .wv-password-{{ section.id }} .wv-password__admin-btn:hover {
    background: var(--wv-bone, #F5F0EB);
    color: var(--wv-black, #0E0E0E);
  }

  @media screen and (max-width: 749px) {
    .wv-password-{{ section.id }} .wv-password__form {
      flex-direction: column;
    }

    .wv-password-{{ section.id }} .wv-password__email-input {
      border-right: 1px solid rgba(255, 255, 255, 0.15);
      margin-bottom: 0.5rem;
    }
  }
</style>

<div class="wv-password-{{ section.id }}">
  <div class="wv-password__inner">
    {%- comment -%} Logo {%- endcomment -%}
    <div class="wv-password__logo">
      {%- if settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 320 }}"
          alt="{{ settings.logo.alt | default: shop.name | escape }}"
          class="wv-password__logo-image"
          width="160"
          loading="eager"
        >
      {%- else -%}
        <span class="wv-password__logo-text">WOLVESTRY</span>
      {%- endif -%}
    </div>

    {%- if section.settings.heading != blank -%}
      <h1 class="wv-password__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="wv-password__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- comment -%} Email signup form {%- endcomment -%}
    {% form 'customer' %}
      {%- if form.posted_successfully? -%}
        <p class="wv-password__success">You're in the pack. We'll let you know when we launch.</p>
      {%- else -%}
        {%- if form.errors -%}
          <div class="wv-password__errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <input type="hidden" name="contact[tags]" value="prospect,password-page">
        <div class="wv-password__form">
          <input
            type="email"
            name="contact[email]"
            class="wv-password__email-input"
            placeholder="Enter your email"
            required
            autocomplete="email"
            aria-label="Email address"
          >
          <button type="submit" class="wv-password__submit">Notify Me</button>
        </div>
      {%- endif -%}
    {% endform %}

    {%- comment -%} Admin password entry {%- endcomment -%}
    <div class="wv-password__admin">
      <button type="button" class="wv-password__admin-toggle" id="wv-admin-toggle-{{ section.id }}">
        Enter using password
      </button>

      <div class="wv-password__admin-form" id="wv-admin-form-{{ section.id }}">
        {% form 'storefront_password' %}
          {%- if form.errors -%}
            <div class="wv-password__errors">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <input
            type="password"
            name="password"
            class="wv-password__admin-input"
            placeholder="Password"
            aria-label="Store password"
            autocomplete="current-password"
          >
          <button type="submit" class="wv-password__admin-btn">Enter</button>
        {% endform %}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var toggle = document.getElementById('wv-admin-toggle-{{ section.id }}');
    var form = document.getElementById('wv-admin-form-{{ section.id }}');
    if (toggle && form) {
      toggle.addEventListener('click', function () {
        form.classList.toggle('is-visible');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Wolvestry Password",
  "tag": "section",
  "class": "wv-password-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WEAR THE WILD."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Something bold is coming. Join the pack and get 10% off our first drop."
    }
  ],
  "presets": [
    {
      "name": "Wolvestry Password"
    }
  ]
}
{% endschema %}
