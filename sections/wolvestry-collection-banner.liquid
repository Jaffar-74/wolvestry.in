{%- liquid
  assign show_description = section.settings.show_description
  assign show_image = section.settings.show_image
  assign has_image = false
  if collection.image != blank and show_image
    assign has_image = true
  endif
-%}

<style>
  .wv-collection-banner-{{ section.id }} {
    position: relative;
    padding: 6rem 2rem;
    text-align: center;
    background: var(--wv-black, #0E0E0E);
    color: var(--wv-bone, #F5F0EB);
    overflow: hidden;
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wv-collection-banner-{{ section.id }} .wv-collection-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .wv-collection-banner-{{ section.id }} .wv-collection-banner__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wv-collection-banner-{{ section.id }} .wv-collection-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.4) 50%,
      rgba(0, 0, 0, 0.7) 100%
    );
    pointer-events: none;
  }

  .wv-collection-banner-{{ section.id }} .wv-collection-banner__content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    margin: 0 auto;
  }

  .wv-collection-banner-{{ section.id }} .wv-collection-banner__title {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(2.4rem, 6vw, 5rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
    margin: 0 0 1rem;
  }

  .wv-collection-banner-{{ section.id }} .wv-collection-banner__description {
    color: var(--wv-muted, #999);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @media screen and (max-width: 749px) {
    .wv-collection-banner-{{ section.id }} {
      padding: 4rem 1.25rem;
      min-height: 200px;
    }
  }
</style>

<div class="wv-collection-banner-{{ section.id }}">
  {%- if has_image -%}
    <div class="wv-collection-banner__bg">
      <img
        src="{{ collection.image | image_url: width: 1920 }}"
        srcset="
          {{ collection.image | image_url: width: 960 }} 960w,
          {{ collection.image | image_url: width: 1440 }} 1440w,
          {{ collection.image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt="{{ collection.image.alt | escape | default: collection.title | escape }}"
        loading="eager"
        width="{{ collection.image.width }}"
        height="{{ collection.image.height }}"
      >
    </div>
    <div class="wv-collection-banner__overlay"></div>
  {%- endif -%}

  <div class="wv-collection-banner__content">
    <h1 class="wv-collection-banner__title">{{ collection.title }}</h1>

    {%- if show_description and collection.description != blank -%}
      <div class="wv-collection-banner__description">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wolvestry Collection Banner",
  "tag": "section",
  "class": "wv-collection-banner-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Wolvestry Collection Banner"
    }
  ]
}
{% endschema %}
