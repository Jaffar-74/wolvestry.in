<style>
  .wv-page-{{ section.id }} {
    padding: var(--section-spacing, 4rem) 0;
  }

  .wv-page-{{ section.id }} .wv-page__inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .wv-page-{{ section.id }} .wv-page__title {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(2rem, 5vw, 3.6rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.1;
    margin: 0 0 2.5rem;
    color: var(--wv-bone, #F5F0EB);
  }

  .wv-page-{{ section.id }} .wv-page__content {
    text-align: left;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--wv-muted, #999);
  }

  .wv-page-{{ section.id }} .wv-page__content h1,
  .wv-page-{{ section.id }} .wv-page__content h2,
  .wv-page-{{ section.id }} .wv-page__content h3,
  .wv-page-{{ section.id }} .wv-page__content h4 {
    font-family: var(--font-heading, sans-serif);
    color: var(--wv-bone, #F5F0EB);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 2rem;
  }

  .wv-page-{{ section.id }} .wv-page__content p {
    margin: 0 0 1.25rem;
  }

  .wv-page-{{ section.id }} .wv-page__content a {
    color: var(--wv-bone, #F5F0EB);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .wv-page-{{ section.id }} .wv-page__content a:hover {
    opacity: 0.7;
  }

  .wv-page-{{ section.id }} .wv-page__content ul,
  .wv-page-{{ section.id }} .wv-page__content ol {
    padding-left: 1.5rem;
    margin: 0 0 1.25rem;
  }

  .wv-page-{{ section.id }} .wv-page__content img {
    max-width: 100%;
    height: auto;
    margin: 1.5rem 0;
  }

  @media screen and (max-width: 749px) {
    .wv-page-{{ section.id }} .wv-page__inner {
      padding: 0 1.25rem;
    }
  }
</style>

<div class="wv-page-{{ section.id }}">
  <div class="page-width">
    <div class="wv-page__inner">
      {%- if section.settings.show_title and page.title != blank -%}
        <h1 class="wv-page__title">{{ page.title }}</h1>
      {%- endif -%}

      <div class="wv-page__content rte">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wolvestry Page",
  "tag": "section",
  "class": "wv-page-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Wolvestry Page"
    }
  ]
}
{% endschema %}
