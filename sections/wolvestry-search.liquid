<style>
  .wv-search-{{ section.id }} {
    padding: var(--section-spacing, 4rem) 0;
  }

  .wv-search-{{ section.id }} .wv-search__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .wv-search-{{ section.id }} .wv-search__heading {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(2rem, 5vw, 3.6rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-align: center;
    margin: 0 0 2.5rem;
    color: var(--wv-bone, #F5F0EB);
  }

  .wv-search-{{ section.id }} .wv-search__form {
    max-width: 560px;
    margin: 0 auto 3rem;
    display: flex;
  }

  .wv-search-{{ section.id }} .wv-search__input {
    flex: 1;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-right: none;
    color: var(--wv-bone, #F5F0EB);
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.85rem;
    padding: 0.9rem 1.25rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .wv-search-{{ section.id }} .wv-search__input::placeholder {
    color: var(--wv-muted, #999);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
  }

  .wv-search-{{ section.id }} .wv-search__input:focus {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .wv-search-{{ section.id }} .wv-search__submit {
    background: var(--wv-bone, #F5F0EB);
    color: var(--wv-black, #0E0E0E);
    border: 1px solid var(--wv-bone, #F5F0EB);
    padding: 0.9rem 1.5rem;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .wv-search-{{ section.id }} .wv-search__submit:hover {
    opacity: 0.85;
  }

  .wv-search-{{ section.id }} .wv-search__count {
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--wv-muted, #999);
    margin-bottom: 2rem;
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  .wv-search-{{ section.id }} .wv-search__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .wv-search-{{ section.id }} .wv-search__empty {
    text-align: center;
    padding: 4rem 2rem;
  }

  .wv-search-{{ section.id }} .wv-search__empty-text {
    font-family: var(--font-heading, sans-serif);
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--wv-bone, #F5F0EB);
    margin: 0 0 0.75rem;
  }

  .wv-search-{{ section.id }} .wv-search__empty-sub {
    color: var(--wv-muted, #999);
    font-size: 0.85rem;
    margin: 0;
  }

  .wv-search-{{ section.id }} .wv-search__pagination {
    margin-top: 4rem;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .wv-search-{{ section.id }} .wv-search__pagination a,
  .wv-search-{{ section.id }} .wv-search__pagination span.current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--wv-muted, #999);
    text-decoration: none;
    font-size: 0.75rem;
    font-family: var(--font-body, 'Inter', sans-serif);
    transition: all 0.2s ease;
  }

  .wv-search-{{ section.id }} .wv-search__pagination a:hover,
  .wv-search-{{ section.id }} .wv-search__pagination span.current {
    background: var(--wv-bone, #F5F0EB);
    color: var(--wv-black, #0E0E0E);
    border-color: var(--wv-bone, #F5F0EB);
  }

  @media screen and (max-width: 749px) {
    .wv-search-{{ section.id }} .wv-search__inner {
      padding: 0 1.25rem;
    }

    .wv-search-{{ section.id }} .wv-search__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
</style>

<div class="wv-search-{{ section.id }}">
  <div class="page-width">
    <div class="wv-search__inner">
      {%- if section.settings.heading != blank -%}
        <h1 class="wv-search__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" class="wv-search__form" role="search">
        <input type="hidden" name="type" value="product">
        <input
          type="search"
          name="q"
          class="wv-search__input"
          placeholder="Search products..."
          value="{{ search.terms | escape }}"
          aria-label="Search"
          autocomplete="off"
        >
        <button type="submit" class="wv-search__submit">
          {% render 'wolvestry-icons', name: 'search', size: 16 %}
          Search
        </button>
      </form>

      {%- if search.performed -%}
        {%- if search.results_count > 0 -%}
          <p class="wv-search__count">
            {{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }} for "{{ search.terms }}"
          </p>

          {%- paginate search.results by 16 -%}
            <div class="wv-search__grid">
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}
                  <div class="wv-search__item">
                    {% render 'wolvestry-card', card_product: item %}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <div class="wv-search__pagination">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}">{{ part.title }}</a>
                  {%- else -%}
                    {%- if part.title == paginate.current_page -%}
                      <span class="current">{{ part.title }}</span>
                    {%- else -%}
                      <span>{{ part.title }}</span>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        {%- else -%}
          <div class="wv-search__empty">
            <p class="wv-search__empty-text">No results found</p>
            <p class="wv-search__empty-sub">Try a different search term or browse our collections.</p>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wolvestry Search",
  "tag": "section",
  "class": "wv-search-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SEARCH"
    }
  ],
  "presets": [
    {
      "name": "Wolvestry Search"
    }
  ]
}
{% endschema %}
