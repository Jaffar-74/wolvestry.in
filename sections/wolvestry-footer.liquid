{% comment %}
  Wolvestry Footer Section
  - Dark multi-column footer with logo, link columns, social, newsletter, payments
{% endcomment %}

<style>
  .wolvestry-footer {
    background: var(--wv-black, #0E0E0E);
    color: var(--wv-bone, #F5F0EB);
    padding: 8rem 2rem 4rem;
  }

  .footer__inner {
    max-width: 1440px;
    margin: 0 auto;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 3rem;
  }

  /* --- Brand Column --- */
  .footer__brand {
    padding-right: 2rem;
  }

  .footer__brand-logo-link {
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .footer__brand-logo-image {
    display: block;
    height: auto;
  }

  .footer__brand-logo-text {
    color: var(--wv-bone, #F5F0EB);
    font-family: var(--wv-font-heading, 'Inter', sans-serif);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
  }

  .footer__brand-description {
    color: var(--wv-muted, #999);
    font-size: 0.85rem;
    line-height: 1.7;
    font-family: 'Inter', sans-serif;
    margin: 0 0 0.5rem;
  }

  .footer__brand-tagline {
    color: var(--wv-bone, #F5F0EB);
    font-size: 0.85rem;
    font-family: var(--wv-font-heading, 'Inter', sans-serif);
    font-weight: 600;
    letter-spacing: 0.1em;
    margin: 0;
  }

  /* --- Link Columns --- */
  .footer__column-heading {
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.7rem;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    color: var(--wv-bone, #F5F0EB);
    margin: 0 0 1.5rem;
  }

  .footer__link-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__link-list li {
    margin-bottom: 0.75rem;
  }

  .footer__link-list a {
    color: var(--wv-muted, #999);
    text-decoration: none;
    font-size: 0.85rem;
    font-family: 'Inter', sans-serif;
    transition: color 0.2s ease;
    line-height: 1.6;
  }

  .footer__link-list a:hover {
    color: var(--wv-bone, #F5F0EB);
  }

  /* --- Social Icons --- */
  .footer__social {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--wv-muted, #999);
    transition: color 0.2s ease;
  }

  .footer__social-link:hover {
    color: var(--wv-bone, #F5F0EB);
  }

  .footer__social-link svg {
    width: 14px;
    height: 14px;
  }

  /* --- Newsletter --- */
  .footer__newsletter {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer__newsletter-heading {
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.7rem;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    color: var(--wv-bone, #F5F0EB);
    margin: 0 0 1rem;
  }

  .footer__newsletter-form {
    display: flex;
    gap: 0;
    max-width: 420px;
  }

  .footer__newsletter-input {
    flex: 1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-right: none;
    color: var(--wv-bone, #F5F0EB);
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    font-family: 'Inter', sans-serif;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .footer__newsletter-input::placeholder {
    color: var(--wv-muted, #999);
  }

  .footer__newsletter-input:focus {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .footer__newsletter-btn {
    background: var(--wv-bone, #F5F0EB);
    color: var(--wv-black, #0E0E0E);
    border: none;
    padding: 0.75rem 1.5rem;
    font-size: 0.7rem;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .footer__newsletter-btn:hover {
    opacity: 0.85;
  }

  /* --- Payment Icons --- */
  .footer__payments {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer__payments svg,
  .footer__payments img {
    height: 24px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .footer__payments svg:hover,
  .footer__payments img:hover {
    opacity: 0.8;
  }

  /* --- Bottom Bar --- */
  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2rem;
    margin-top: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer__copyright {
    color: var(--wv-muted, #999);
    font-size: 0.7rem;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0;
  }

  .footer__site-link {
    color: var(--wv-muted, #999);
    text-decoration: none;
    font-size: 0.7rem;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .footer__site-link:hover {
    color: var(--wv-bone, #F5F0EB);
  }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .wolvestry-footer {
      padding: 4rem 1.25rem 2.5rem;
    }

    .footer__columns {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer__brand {
      padding-right: 0;
    }

    .footer__newsletter-form {
      max-width: 100%;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .footer__columns {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }
</style>

<footer class="wolvestry-footer" role="contentinfo">
  <div class="footer__inner">
    <div class="footer__columns">

      <!-- Brand Column -->
      <div class="footer__brand">
        <a href="/" class="footer__brand-logo-link" aria-label="{{ shop.name }}">
          {%- if settings.logo != blank -%}
            {%- assign logo_width = settings.logo_width | default: 140 -%}
            <img
              src="{{ settings.logo | image_url: width: logo_width }}"
              alt="{{ settings.logo.alt | default: shop.name | escape }}"
              class="footer__brand-logo-image"
              width="{{ logo_width }}"
              height="{{ logo_width | divided_by: settings.logo.aspect_ratio }}"
              loading="lazy"
            >
          {%- else -%}
            <svg class="footer__wolf-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="24" height="24" fill="currentColor" style="margin-right: 0.5rem; color: var(--wv-bone, #F5F0EB); vertical-align: middle;">
              <path d="M16 2L10 8l-4-2v8l4 6 2 8h8l2-8 4-6V6l-4 2-6-6zm-4 10l2-2 2 3-2 3-2-1v-3zm8 0v3l-2 1-2-3 2-3 2 2zm-4 6l-3-2 3-4 3 4-3 2z"/>
            </svg>
            <span class="footer__brand-logo-text">{{ section.settings.heading }}</span>
          {%- endif -%}
        </a>
        <p class="footer__brand-description">{{ section.settings.description }}</p>
        <p class="footer__brand-tagline">Wear the Wild.</p>

        <!-- Social Icons -->
        <div class="footer__social" aria-label="Social media links">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              {% render 'wolvestry-icons', name: 'instagram' %}
            </a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" class="footer__social-link" aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
              {% render 'wolvestry-icons', name: 'x' %}
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" class="footer__social-link" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
              {% render 'wolvestry-icons', name: 'youtube' %}
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Link Columns (from blocks) -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_column' -%}
          <div class="footer__link-column" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h4 class="footer__column-heading">{{ block.settings.title }}</h4>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              {%- assign link_menu = linklists[block.settings.menu] -%}
              {%- if link_menu.links.size > 0 -%}
                <ul class="footer__link-list">
                  {%- for link in link_menu.links -%}
                    <li>
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <!-- Newsletter -->
    {%- if section.settings.show_newsletter -%}
      <div class="footer__newsletter">
        <h4 class="footer__newsletter-heading">Stay in the Pack</h4>
        {%- form 'customer', id: 'footer-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="footer__newsletter-form">
            <input
              type="email"
              name="contact[email]"
              class="footer__newsletter-input"
              placeholder="Enter your email"
              autocomplete="email"
              aria-label="Email address"
              required
            >
            <button type="submit" class="footer__newsletter-btn">Subscribe</button>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}

    <!-- Payment Icons -->
    {%- if section.settings.show_payment_icons -%}
      {%- assign enabled_payment_types = shop.enabled_payment_types -%}
      {%- if enabled_payment_types.size > 0 -%}
        <div class="footer__payments" aria-label="Accepted payment methods">
          {%- for type in enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} WOLVESTRY. ALL RIGHTS RESERVED.</p>
      <a href="/" class="footer__site-link">WOLVESTRY.IN</a>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Wolvestry Footer",
  "tag": "section",
  "class": "wolvestry-footer-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Brand name",
      "default": "WOLVESTRY"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Brand description",
      "default": "Premium unisex fashion from India."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column heading",
          "default": "Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wolvestry Footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": {
            "title": "SHOP",
            "menu": "shop"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "title": "INFO",
            "menu": "info"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "title": "SUPPORT",
            "menu": "support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
