[
  {
    "name": "theme_info",
    "theme_name": "Wolvestry",
    "theme_version": "1.0.0",
    "theme_author": "Wolvestry",
    "theme_documentation_url": "https://wolvestry.in",
    "theme_support_url": "https://wolvestry.in/contact"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 150,
        "unit": "px"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "colors_solid_button_labels",
        "label": "Solid button label",
        "default": "#0E0E0E"
      },
      {
        "type": "color",
        "id": "colors_accent_1",
        "label": "Accent 1",
        "default": "#EDE8DF"
      },
      {
        "type": "color",
        "id": "colors_text",
        "label": "Text",
        "default": "#EDE8DF"
      },
      {
        "type": "color",
        "id": "colors_background_1",
        "label": "Background",
        "default": "#0E0E0E"
      },
      {
        "type": "color",
        "id": "colors_background_2",
        "label": "Background 2",
        "default": "#1A1A1A"
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "id": "scheme_1",
            "name": "Dark",
            "settings": {
              "background": "#0E0E0E",
              "text": "#EDE8DF",
              "button_background": "#EDE8DF",
              "button_label": "#0E0E0E"
            }
          },
          {
            "id": "scheme_2",
            "name": "Light",
            "settings": {
              "background": "#EDE8DF",
              "text": "#0E0E0E",
              "button_background": "#0E0E0E",
              "button_label": "#EDE8DF"
            }
          },
          {
            "id": "scheme_3",
            "name": "Strip",
            "settings": {
              "background": "#5A5F66",
              "text": "#EDE8DF",
              "button_background": "#EDE8DF",
              "button_label": "#0E0E0E"
            }
          }
        ]
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font",
        "default": "barlow_condensed_n8"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "default": 100,
        "unit": "%"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1920,
        "step": 100,
        "default": 1600,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "Section spacing",
        "min": 0,
        "max": 200,
        "step": 4,
        "default": 100,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "default": 0,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "select",
        "id": "button_style",
        "label": "Button style",
        "options": [
          {
            "value": "outline",
            "label": "Outline"
          },
          {
            "value": "solid",
            "label": "Solid"
          }
        ],
        "default": "outline"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_twitter_link",
        "label": "Twitter"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (in paise)",
        "default": 99900
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable animations",
        "default": true
      }
    ]
  }
]
